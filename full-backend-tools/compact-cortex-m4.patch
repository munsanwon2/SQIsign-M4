+        params->q <= 0 || params->primality_test_iterations <= 0 ||
+        params->prime_list_length > IBZ_CORNACCHIA_MAX_PRIMES ||
+        (params->prime_list_length != 0 && params->prime_list == NULL) ||
+        ibz_cmp(n, &ibz_const_zero) <= 0)
+        return 0;
